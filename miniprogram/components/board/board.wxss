.board{display:flex;flex-wrap:wrap;width:100%;aspect-ratio:1;border:3rpx solid #243b5a;border-radius:10rpx;overflow:hidden;background:white;box-sizing:border-box}.cell{width:11.111111%;height:11.111111%;position:relative;box-sizing:border-box;border-right:1rpx solid #dbe3ed;border-bottom:1rpx solid #dbe3ed;display:flex;align-items:center;justify-content:center;color:#243b5a}.box-right{border-right:3rpx solid #243b5a}.box-bottom{border-bottom:3rpx solid #243b5a}.value{font-size:38rpx;font-weight:650}.notes{width:100%;height:100%;display:flex;flex-wrap:wrap;padding:3rpx;box-sizing:border-box}.note{width:33.333%;height:33.333%;font-size:18rpx;line-height:1.2;text-align:center;color:#64748b}.marked{background:#e8f0ff}.selected{background:#dbeafe;box-shadow:inset 0 0 0 3rpx #2563eb}.active{background:#e0e7ff;box-shadow:inset 0 0 0 4rpx #4f46e5}.target{background:#fee2e2;color:#b91c1c;text-decoration:line-through;font-weight:700}.conflict{background:#fff1f2;color:#b91c1c}.corner{position:absolute;right:1rpx;top:-3rpx;color:#2563eb;font-size:12rpx}.error-mark{position:absolute;right:2rpx;top:0;font-size:20rpx;color:#b91c1c;font-weight:700}
