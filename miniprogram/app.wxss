page{background:#f5f7fb;color:#172b4d;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}view,text,button{box-sizing:border-box}button{font-size:28rpx;border-radius:18rpx;line-height:1.5;padding:22rpx 24rpx;background:#edf2fa;color:#334155;font-weight:600;margin:0}button::after{border:0}button[disabled]{opacity:.45}button.primary{background:#2563eb;color:white}button.small{padding:14rpx 20rpx;font-size:24rpx}.page{padding:30rpx 28rpx 50rpx}.eyebrow{font-size:21rpx;letter-spacing:4rpx;color:#2563eb;font-weight:700}.title{font-size:48rpx;font-weight:750;line-height:1.25;margin:12rpx 0 20rpx}.subtitle,.muted{color:#64748b;font-size:26rpx}.card{background:white;border:1rpx solid #e5ebf3;border-radius:24rpx;padding:28rpx;margin-top:22rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.stack{display:flex;flex-direction:column;gap:14rpx}.section-title{font-size:31rpx;font-weight:700}.badge{font-size:22rpx;padding:6rpx 15rpx;border-radius:20rpx;background:#eff6ff;color:#1d4ed8;white-space:nowrap}.notice{padding:20rpx;border:1rpx solid #f2c975;background:#fffbeb;color:#854d0e;border-radius:16rpx;margin:18rpx 0;font-size:25rpx}.success{background:#ecfdf5;color:#047857}.actions{display:flex;gap:14rpx;margin-top:20rpx}.actions button{flex:1}.digits{display:flex;gap:8rpx;margin-top:18rpx}.digits button{flex:1;padding:15rpx 0;min-width:0;font-size:34rpx;border-radius:12rpx}.digits button.chosen{background:#2563eb;color:white}.divider{height:1rpx;background:#e5ebf3;margin:22rpx 0}.link{color:#2563eb}.help{font-size:24rpx;line-height:1.7;color:#64748b}.empty{padding:60rpx 20rpx;text-align:center}
