<wxs module="helpers">module.exports.includes = function(list, value) { return list.indexOf(value) !== -1; };</wxs>
<view class="page training"><view wx:if="{{error}}" class="notice">{{error}}</view><block wx:if="{{lesson}}"><view class="row"><view><view class="eyebrow">{{title}}</view><view class="section-title">{{lesson.title}}</view></view><text class="badge">{{example?'观察与理解':assisted?'辅助练习':'独立练习'}}</text></view><view class="board-wrap"><sudoku-board board="{{lesson.board}}" candidates="{{lesson.candidates}}" selected="{{selected}}" targets="{{displayTargets}}" active="{{active}}" marks="{{marks}}" bind:celltap="selectCell" /></view>
<block wx:if="{{example}}"><view class="card explanation"><view class="eyebrow">第 {{step+1}} / {{lesson.steps.length}} 步</view><view>{{lesson.steps[step].text}}</view></view><view class="actions"><button disabled="{{step===0}}" data-delta="-1" bindtap="moveStep">上一步</button><button class="primary" disabled="{{step===lesson.steps.length-1}}" data-delta="1" bindtap="moveStep">下一步</button></view><button class="finish" bindtap="back">返回课程，开始练习</button></block>
<block wx:else><view class="actions phases"><button class="{{phase==='structure'?'primary':''}}" data-phase="structure" bindtap="phase">① 选择结构 {{selected.length}}</button><button class="{{phase==='elimination'?'primary':''}}" data-phase="elimination" bindtap="phase">② 选择删数 {{targets.length}}</button></view><view class="help instruction">{{phase==='structure'?'点击关键空格，组成这项技巧的结构。◆ 表示已选。':'先点击要删数的格子，再用下方数字键选择候选数。划线表示待删。'}}</view><view wx:if="{{focusLabel}}" class="focus-label">{{focusLabel}}</view><view wx:if="{{phase==='elimination'}}" class="digits"><button wx:for="{{digits}}" wx:key="*this" disabled="{{done||!helpers.includes(available,item)}}" class="{{helpers.includes(chosen,item)?'chosen':''}}" data-digit="{{item}}" bindtap="digit">{{item}}</button></view><view wx:if="{{message}}" class="notice {{done?'success':''}}">{{message}}</view><view wx:if="{{hint}}" class="card explanation"><view class="eyebrow">{{hint===1?'观察提示':'推理解释'}}</view><view>{{lesson.steps[hint].text}}</view></view><view class="actions"><button id="check-answer" class="primary" bindtap="submit" disabled="{{done}}">检查推理</button><button id="show-hint" bindtap="reveal" disabled="{{hint===2||done}}">{{hint===0?'给我提示':'查看解释'}}</button></view><view class="actions"><button class="small" bindtap="reset">重新选择</button><button class="small" bindtap="back">返回课程</button></view><view class="help instruction">提交至少一个有效删数即可。提示会标记为辅助练习，不扣分。</view></block></block></view>
