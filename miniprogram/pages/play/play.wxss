.play-page{padding-top:26rpx}.heading{align-items:flex-start}.heading .title{font-size:40rpx;flex:1}.heading button{flex-shrink:0;margin-top:12rpx}.picker{margin-bottom:28rpx}.puzzle-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin:24rpx 0}.puzzle-button{text-align:left;font-size:26rpx;padding:20rpx}.puzzle-hint{display:block;font-size:21rpx;color:#64748b;font-weight:400;margin-top:6rpx}.game-info{margin:24rpx 0 18rpx}.clock{text-align:right;font-size:38rpx;font-variant-numeric:tabular-nums;line-height:1.2;font-weight:650}.clock-label{display:block;font-size:21rpx;color:#64748b;font-weight:400;margin-top:7rpx}.board-wrap{border-radius:16rpx;overflow:hidden;background:#fff}.pause-panel{height:680rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20rpx;border:2rpx solid #dbe4ef;border-radius:16rpx}.pause-symbol{font-size:66rpx;color:#2563eb}.pause-panel button{margin-top:18rpx;padding:20rpx 64rpx}.selection{font-size:25rpx;color:#475569;margin:20rpx 0 12rpx;min-height:40rpx}.tools{display:flex;gap:10rpx}.tools button{flex:1;padding:17rpx 4rpx;font-size:24rpx}.conflict-tip{font-size:24rpx;color:#b42318;margin:10rpx 0}.footnote{margin-top:18rpx;min-height:76rpx}.local-note{margin-top:24rpx;text-align:center;font-size:22rpx}.retry,.replay{margin-top:12rpx}.digits button{min-height:88rpx}@media(max-width:350px){.play-page{padding-left:20rpx;padding-right:20rpx}.heading .title{font-size:36rpx}.digits{gap:5rpx}.tools button{font-size:23rpx}}
